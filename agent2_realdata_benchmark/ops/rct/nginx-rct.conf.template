# TEMPLATE ONLY: supply genuine DNS name and issued certificates.
# Nginx and application must be on the SAME host; WSGI only binds 127.0.0.1.
# Do not proxy from arbitrary public networks or accept client-supplied forwarding headers.
server {
    listen 80;
    server_name REPLACE_WITH_REAL_STUDY_HOST.example.invalid;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name REPLACE_WITH_REAL_STUDY_HOST.example.invalid;
    ssl_certificate /etc/letsencrypt/live/REPLACE_WITH_REAL_STUDY_HOST/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/REPLACE_WITH_REAL_STUDY_HOST/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 16k;
    access_log off; # Study request metadata and invitation URLs must not be logged.
    location / {
        proxy_pass http://127.0.0.1:8077;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Connection "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 130s;
        proxy_send_timeout 130s;
        proxy_buffering on;
    }
}
